{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mjavmjav",
  "account_id": "bceaeae4788dce3493514fde194b4a7e",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*", "/mcp", "/oauth/*", "/.well-known/*"
    ]
  },
  "routes": [
    {
      "pattern": "mjavmjav.com",
      "custom_domain": true
    },
    {
      "pattern": "www.mjavmjav.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CAT_ROOMS",
        "class_name": "CatRoom"
      },
      { "name": "ROULETTE_AUTH", "class_name": "RouletteAuth" },
      { "name": "ROULETTE_QUEUE", "class_name": "RouletteQueue" },
      { "name": "ROULETTE_MATCHES", "class_name": "RouletteMatch" }
    ]
  },
  "migrations": [
    {
      "tag": "v1-cat-rooms",
      "new_sqlite_classes": [
        "CatRoom"
      ]
    },
    { "tag": "v2-roulette", "new_sqlite_classes": ["RouletteAuth", "RouletteQueue", "RouletteMatch"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
